{
  "name": "ccreator-mcp",
  "version": "0.1.1",
  "title": "i18n:ccreator-mcp.title",
  "package_version": 2,
  "description": "i18n:ccreator-mcp.description",
  "author": "AdsCraft team",
  "license": "MIT",
  "homepage": "https://github.com/blackbeans-1301/cocos-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/blackbeans-1301/cocos-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/blackbeans-1301/cocos-mcp/issues"
  },
  "keywords": [
    "cocos-creator",
    "mcp",
    "model-context-protocol",
    "ai",
    "extension"
  ],
  "private": true,
  "type": "commonjs",
  "main": "./dist/main.js",
  "editor": "^3.8.8",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.mjs",
    "clean": "rimraf dist",
    "icon": "node scripts/make-icon.mjs",
    "pack": "npm run build && node scripts/pack.mjs",
    "screenshots": "node scripts/make-screenshots.mjs",
    "promo": "node scripts/make-promo.mjs"
  },
  "panels": {
    "main": {
      "title": "i18n:ccreator-mcp.title",
      "main": "./dist/panel/index.js",
      "type": "simple",
      "size": {
        "min-width": 560,
        "min-height": 420,
        "width": 640,
        "height": 520
      }
    }
  },
  "contributions": {
    "menu": [
      {
        "path": "Extension",
        "label": "i18n:ccreator-mcp.menu",
        "message": "open-panel"
      }
    ],
    "shortcuts": [
      {
        "message": "open-panel",
        "win": "ctrl+shift+m",
        "mac": "cmd+shift+m"
      }
    ],
    "messages": {
      "open-panel": {
        "methods": [
          "open-panel"
        ]
      },
      "mcp-status": {
        "methods": [
          "mcp-status"
        ]
      },
      "mcp-set-enabled": {
        "methods": [
          "mcp-set-enabled"
        ]
      },
      "mcp-set-port": {
        "methods": [
          "mcp-set-port"
        ]
      },
      "mcp-agents": {
        "methods": [
          "mcp-agents"
        ]
      },
      "mcp-configure-agent": {
        "methods": [
          "mcp-configure-agent"
        ]
      },
      "mcp-restart": {
        "methods": [
          "mcp-restart"
        ]
      }
    },
    "scene": {
      "script": "./dist/scene.js"
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.0"
  }
}
